  <example name="comprehensive_test_strategy_development">
    <description>Complete workflow for developing a comprehensive testing strategy for a new application</description>
    <scenario>
      User requests: "I need to implement comprehensive testing for my new e-commerce application. We want to ensure high quality before launch."
    </scenario>
    <workflow_steps>
      <step number="1">
        <title>Initial Assessment and Requirements Gathering</title>
        <actions>
          <action>Use search_files to find existing test files and configuration</action>
          <action>Use read_file to understand current testing approach</action>
          <action>Use list_files to map out project structure</action>
          <action>Ask follow-up questions to clarify quality requirements</action>
        </actions>
        <tools_used>
          <tool>search_files - Find existing test patterns</tool>
          <tool>read_file - Analyze current test implementation</tool>
          <tool>list_files - Understand project structure</tool>
          <tool>ask_followup_question - Clarify requirements</tool>
        </tools_used>
      </step>
      
      <step number="2">
        <title>Test Strategy Development</title>
        <actions>
          <action>Analyze application architecture and identify testing needs</action>
          <action>Define test types and coverage requirements</action>
          <action>Establish quality metrics and acceptance criteria</action>
          <action>Create comprehensive test strategy document</action>
        </actions>
        <deliverables>
          <deliverable>Test strategy document with scope and approach</deliverable>
          <deliverable>Quality metrics definition and thresholds</deliverable>
          <deliverable>Test environment requirements</deliverable>
        </deliverables>
      </step>
      
      <step number="3">
        <title>Test Implementation</title>
        <actions>
          <action>Create unit tests for core business logic</action>
          <action>Implement integration tests for API endpoints</action>
          <action>Develop end-to-end tests for critical user journeys</action>
          <action>Set up performance and security testing</action>
        </actions>
        <tools_used>
          <tool>write_to_file - Create new test files</tool>
          <tool>apply_diff - Modify existing configurations</tool>
          <tool>execute_command - Run tests and generate coverage</tool>
        </tools_used>
        <deliverables>
          <deliverable>Unit test suite with >90% coverage</deliverable>
          <deliverable>Integration test suite for all APIs</deliverable>
          <deliverable>E2E test suite for critical workflows</deliverable>
          <deliverable>Performance test baseline and thresholds</deliverable>
        </deliverables>
      </step>
      
      <step number="4">
        <title>Quality Validation and Reporting</title>
        <actions>
          <action>Execute comprehensive test suite</action>
          <action>Generate coverage and quality reports</action>
          <action>Validate against quality requirements</action>
          <action>Create quality dashboard and metrics</action>
        </actions>
        <tools_used>
          <tool>execute_command - Run test suites</tool>
          <tool>read_file - Review test results</tool>
          <tool>write_to_file - Generate quality reports</tool>
        </tools_used>
        <deliverables>
          <deliverable>Test execution report with results</deliverable>
          <deliverable>Coverage analysis and gaps identification</deliverable>
          <deliverable>Quality metrics dashboard</deliverable>
          <deliverable>Recommendations for improvement</deliverable>
        </deliverables>
      </step>
    </workflow_steps>
    <completion_criteria>
      <criterion>Test strategy documented and approved</criterion>
      <criterion>All test types implemented with required coverage</criterion>
      <criterion>Quality metrics meet defined thresholds</criterion>
      <criterion>Comprehensive documentation provided</criterion>
    </completion_criteria>
  </example>

