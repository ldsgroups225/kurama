<error_handling>
  <overview>
    Error handling strategies for mobile development, covering common issues, debugging approaches, and recovery methods specific to React Native and Flutter applications.
  </overview>

  <common_mobile_errors>
    <error_category name="build_errors">
      <description>Compilation and build-related failures</description>
      <common_errors>
        <error name="dependency_conflicts">
          <symptoms>Version mismatches, peer dependency errors</symptoms>
          <diagnosis>Check package.json, yarn.lock, and Podfile for version conflicts</diagnosis>
          <resolution>
            <step>Clear node_modules and package-lock.json</step>
            <step>Update conflicting dependencies to compatible versions</step>
            <step>Run pod install for iOS dependencies</step>
            <step>Rebuild the application</step>
          </resolution>
        </error>
        
        <error name="native_module_linking">
          <symptoms>Module not found, linking errors during build</symptoms>
          <diagnosis>Native modules not properly linked or installed</diagnosis>
          <resolution>
            <step>Run react-native link for manual linking</step>
            <step>Check iOS Podfile for native dependencies</step>
            <step>Verify Android settings.gradle and build.gradle</step>
            <step>Clean and rebuild the project</step>
          </resolution>
        </error>
        
        <error name="ios_certificate_issues">
          <symptoms>Code signing errors, provisioning profile problems</symptoms>
          <diagnosis>Missing or expired certificates/provisioning profiles</diagnosis>
          <resolution>
            <step>Check Apple Developer account for valid certificates</step>
            <step>Download and install provisioning profiles</step>
            <step>Update Xcode signing settings</step>
            <step>Clean build folder and rebuild</step>
          </resolution>
        </error>
      </common_errors>
    </error_category>

    <error_category name="runtime_errors">
      <description>Errors that occur during app execution</description>
      <common_errors>
        <error name="network_timeout">
          <symptoms>Requests failing, slow loading, timeout errors</symptoms>
          <diagnosis>Poor network connectivity or server issues</diagnosis>
          <resolution>
            <step>Implement retry logic with exponential backoff</step>
            <step>Add network connectivity checks</step>
            <step>Provide offline fallback content</step>
            <step>Show user-friendly error messages</step>
          </resolution>
        </error>
        
        <error name="memory_leaks">
          <symptoms>App slowing down, crashes, high memory usage</symptoms>
          <diagnosis>Improper memory management, retained references</diagnosis>
          <resolution>
            <step>Use memory profiling tools to identify leaks</step>
            <step>Check for circular references in closures</step>
            <step>Properly cleanup listeners and observers</step>
            <step>Implement weak references where appropriate</step>
          </resolution>
        </error>
        
        <error name="state_management_issues">
          <symptoms>UI not updating, inconsistent state, race conditions</symptoms>
          <diagnosis>Improper state updates, async state conflicts</diagnosis>
          <resolution>
            <step>Review state update patterns</step>
            <step>Implement proper async handling</step>
            <step>Add state validation</step>
            <step>Use state debugging tools</step>
          </resolution>
        </error>
      </common_errors>
    </error_category>

    <error_category name="platform_specific">
      <description>Errors specific to iOS or Android platforms</description>
      <common_errors>
        <error name="ios_permission_denied">
          <symptoms>Camera, location, or other permissions not granted</symptoms>
          <diagnosis>Missing Info.plist entries or permission requests</diagnosis>
          <resolution>
            <step>Add required keys to Info.plist</step>
            <step>Implement proper permission request flow</step>
            <step>Handle permission denial gracefully</step>
            <step>Provide clear user instructions</step>
          </resolution>
        </error>
        
        <error name="android_runtime_permissions">
          <symptoms>Permissions not working on Android 6.0+</symptoms>
          <diagnosis>Missing runtime permission requests</diagnosis>
          <resolution>
            <step>Add permissions to AndroidManifest.xml</step>
            <step>Implement runtime permission checks</step>
            <step>Handle permission rationale display</step>
            <step>Provide fallback for denied permissions</step>
          </resolution>
        </error>
      </common_errors>
    </error_category>
  </common_mobile_errors>

