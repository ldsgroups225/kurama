  <backup_strategies>
    <pattern name="postgresql_backup">
      <description>PostgreSQL continuous backup with point-in-time recovery</description>
      <example>
        <code language="bash">
#!/bin/bash
# PostgreSQL Backup Script
BACKUP_DIR="/backups/postgresql"
DATE=$(date +%Y%m%d)
DB_NAME="appdb"

# Create base backup
pg_dump -h localhost -U postgres -d $DB_NAME -f $BACKUP_DIR/$DB_NAME-$DATE.sql

# Compress backup
gzip $BACKUP_DIR/$DB_NAME-$DATE.sql.gz

# Cleanup old backups (keep last 7 days)
find $BACKUP_DIR -name "*.sql.gz" -mtime +7 -delete
        </code>
        <explanation>
          Automated daily backups with compression and retention policy.
        </explanation>
      </example>
    </pattern>
    
    <pattern name="mysql_backup">
      <description>MySQL backup with binary logs and verification</description>
      <example>
        <code language="bash">
#!/bin/bash
# MySQL Backup Script
BACKUP_DIR="/backups/mysql"
DATE=$(date +%Y%m%d)
DB_NAME="appdb"

# Full backup with binary logs
mysqldump --single-transaction --all-databases --routines --triggers --events --master-data=2 --flush-logs --lock-tables --quick --compress --result-file=$BACKUP_DIR/$DB_NAME-$DATE.sql.gz

# Verify backup integrity
mysql --check-tables --check-upgrade --auto-repair $BACKUP_DIR/$DB_NAME-$DATE.sql.gz
        </code>
        <explanation>
          Complete MySQL backups with verification and compression for reliable recovery.
        </explanation>
      </example>
    </pattern>
  </backup_strategies>

  <monitoring_configurations>
    <pattern name="postgresql_monitoring">
      <description>PostgreSQL monitoring with pg_stat_statements and custom metrics</description>
      <example>
        <code language="sql">
-- Enable pg_stat_statements
ALTER SYSTEM SET pg_stat_statements.track = 'all';

-- Create monitoring view
CREATE VIEW db_performance_metrics AS
SELECT 
  schemaname,
  tablename,
  n_tup_ins,
  n_tup_upd,
  n_tup_del,
  seq_scan,
  seq_tup_read,
  idx_scan,
  idx_tup_fetch,
  idx_tup_insert,
  hot_update
        FROM pg_stat_user_tables
        WHERE schemaname NOT IN ('pg_catalog', 'information_schema');

-- Grant access to monitoring view
GRANT SELECT ON db_performance_metrics TO monitoring_role;
        </code>
        <explanation>
          Enable detailed performance monitoring with custom views for better visibility.
        </explanation>
      </example>
    </pattern>
    
    <pattern name="redis_monitoring">
      <description>Redis monitoring with INFO log analysis and key metrics</description>
      <example>
        <code language="conf">
# Redis Monitoring Configuration
logfile /var/log/redis/redis-server.log
loglevel notice
syslog-enabled yes

# Custom monitoring script
redis-cli INFO keyspace | grep -E "used_memory_peak:" | awk '{print $2}' | tail -1
        </code>
        <explanation>
          Monitor Redis memory usage and key patterns for performance optimization.
        </explanation>
      </example>
    </pattern>
  </monitoring_configurations>

  <security_configurations>
    <pattern name="postgresql_security">
      <description>PostgreSQL security hardening with row-level security and encryption</description>
      <example>
        <code language="sql">
-- Enable row-level security
ALTER SYSTEM SET row_security = 'on';

-- Create secure role with limited privileges
CREATE ROLE read_only_role;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO read_only_role;

-- Enable encryption
ALTER SYSTEM SET ssl = 'on';
ALTER SYSTEM SET ssl_cert_file = '/path/to/server.crt';
ALTER SYSTEM SET ssl_key_file = '/path/to/server.key';

-- Audit logging
ALTER SYSTEM SET log_destination = 'csvlog';
ALTER SYSTEM SET log_directory = '/var/log/postgresql/audit';
ALTER SYSTEM SET log_filename = 'postgresql-%Y-%m-%d.log';
        </code>
        <explanation>
          Implement comprehensive security with encryption, limited privileges, and audit logging.
        </explanation>
      </example>
    </pattern>
  </security_configurations>

  <migration_scripts>
    <pattern name="zero_downtime_migration">
      <description>Zero-downtime database migration using blue-green deployment</description>
      <example>
        <code language="sql">
-- Zero-downtime Migration Strategy
-- 1. Setup new database as replica
CREATE DATABASE newdb WITH TEMPLATE template0;

-- 2. Sync data using logical replication
-- Run on new database
pg_dump -h newdb -U replica_user -Fc -v -s | psql -h newdb -c "SELECT pg_start_logical_replication('appdb', 'replication_slot');" 

-- 3. Promote replica to primary
-- When sync is complete, promote new database
SELECT pg_promote_replica('newdb');

-- 4. Update application connection
-- Switch application to new database
        </code>
        <explanation>
          Migrate with zero downtime using logical replication and promotion.
        </explanation>
      </example>
    </pattern>
  </migration_scripts>
</common_patterns>
