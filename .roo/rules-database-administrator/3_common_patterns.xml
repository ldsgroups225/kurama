<common_patterns>
  <database_setup_patterns>
    <pattern name="postgresql_configuration">
      <description>Production-ready PostgreSQL configuration with performance tuning</description>
      <example>
        <code language="sql">
-- PostgreSQL Configuration Example
-- Basic Settings
shared_buffers = 256MB
effective_cache_size = 4GB
work_mem = 2GB
maintenance_work_mem = 1GB

-- Performance Tuning
random_page_cost = 1.1
effective_io_concurrency = 200
checkpoint_completion_target = 0.9
wal_buffers = 16MB
default_statistics_target = 100

-- High Availability Setup
-- Streaming Replication
primary_conninfo = 'host=primary.db port=5432 sslmode=require'
standby_conninfo = 'host=standby.db port=5432 sslmode=require'
recovery_min_apply_delay = 30s
recovery_target_timeline = 5min
        </code>
        <explanation>
          Optimize for high concurrency with proper connection pooling and WAL configuration for write-heavy workloads.
        </explanation>
      </example>
    </pattern>
    
    <pattern name="mysql_optimization">
      <description>MySQL performance optimization with proper indexing</description>
      <example>
        <code language="sql">
-- MySQL Performance Optimization
-- InnoDB Configuration
innodb_buffer_pool_size = 1G
innodb_log_file_size = 256M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT

-- Query Optimization
-- Enable query cache
query_cache_size = 128M
query_cache_type = 1

-- Connection Settings
max_connections = 200
max_allowed_packet = 64M
thread_cache_size = 16M
        </code>
        <explanation>
          Configure InnoDB for OLTP workloads with proper buffer sizing and query caching.
        </explanation>
      </example>
    </pattern>
    
