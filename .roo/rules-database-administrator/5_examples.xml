-- PostgreSQL Security Hardening
-- Enable SSL/TLS
ALTER SYSTEM SET ssl = 'on';
ALTER SYSTEM SET ssl_cert_file = '/etc/ssl/certs/server.crt';
ALTER SYSTEM SET ssl_key_file = '/etc/ssl/private/server.key';
ALTER SYSTEM SET ssl_ca_file = '/etc/ssl/certs/ca.crt';

-- Configure authentication
-- pg_hba.conf
# Require SSL for all connections
hostssl all all 0.0.0.0/0 md5
# Local connections without password
local all all peer

-- Create secure roles
CREATE ROLE read_only_role;
GRANT SELECT ON ALL TABLES IN SCHEMA public TO read_only_role;

CREATE ROLE app_user_role;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO app_user_role;

-- Enable row-level security
ALTER TABLE sensitive_data ENABLE ROW LEVEL SECURITY;

CREATE POLICY user_data_policy ON sensitive_data
    FOR ALL TO app_user_role
    USING (user_id = current_user_id());

-- Enable audit logging
ALTER SYSTEM SET log_destination = 'csvlog';
ALTER SYSTEM SET log_directory = '/var/log/postgresql/audit';
ALTER SYSTEM SET log_filename = 'postgresql-%Y-%m-%d.log';
ALTER SYSTEM SET log_statement = 'all';
ALTER SYSTEM SET log_connections = 'on';
ALTER SYSTEM SET log_disconnections = 'on';

-- Reload configuration
SELECT pg_reload_conf();
    </code>
    <explanation>
      This security hardening implements comprehensive protection including SSL/TLS encryption, role-based access control, row-level security for sensitive data, and comprehensive audit logging for compliance and monitoring.
    </explanation>
  </example>

  <example name="database_migration_zero_downtime">
    <description>Performing zero-downtime database migration</description>
    <context>When you need to upgrade database schema without service interruption</context>
    <workflow>
      <phase name="analysis">
        <step>Review current schema and data volume</step>
        <step>Plan migration steps and rollback strategy</step>
        <step>Prepare testing environment</step>
      </phase>
      <phase name="implementation">
        <step>Setup logical replication from production to staging</step>
        <step>Apply schema changes to staging environment</step>
        <step>Validate application compatibility</step>
        <step>Perform controlled cutover to new schema</step>
      </phase>
      <phase name="validation">
        <step>Monitor application performance after migration</step>
        <step>Verify data integrity and consistency</step>
        <step>Test rollback procedures if needed</step>
      </phase>
    </workflow>
    <code language="sql">
-- Zero-Downtime Migration Strategy
-- Step 1: Setup logical replication
-- On production database
CREATE PUBLICATION migration_pub FOR TABLE users, orders, products;

-- On staging database
CREATE SUBSCRIPTION migration_sub 
CONNECTION 'host=prod-db port=5432 dbname=appdb user=replicator password=secure_password' 
PUBLICATION migration_pub
WITH (slot_name = migration_slot, create_slot = false);

-- Step 2: Apply schema changes to staging
-- Wait for replication to catch up
SELECT pg_subscription_is_active('migration_sub');

-- Apply migrations
ALTER TABLE users ADD COLUMN new_field VARCHAR(255);
CREATE INDEX idx_users_new_field ON users(new_field);

-- Step 3: Validate application compatibility
-- Test application with staging database
-- Run smoke tests and performance tests

-- Step 4: Controlled cutover
-- Stop application writes
SELECT pg_replication_origin_advance('migration_origin', pg_current_wal_lsn());

-- Switch application to staging database
-- Update connection string to point to staging

-- Step 5: Cleanup
-- After successful cutover
DROP SUBSCRIPTION migration_sub;
DROP PUBLICATION migration_pub;
    </code>
    <explanation>
      This zero-downtime migration uses logical replication to create a staging copy of production, applies schema changes safely, validates compatibility, then performs a controlled cutover to minimize service interruption.
    </explanation>
