    </workflow_steps>
    <deliverables>
      <deliverable>Multi-location landing pages with LocalBusiness schema</deliverable>
      <deliverable>Consistent business citations across 20+ directories</deliverable>
      <deliverable>Optimized Google Business Profile with complete information</deliverable>
      <deliverable>Local search monitoring and reporting system</deliverable>
    </deliverables>
  </example>

  <example name="ecommerce_seo_overhaul">
