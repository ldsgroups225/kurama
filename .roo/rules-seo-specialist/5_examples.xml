<![CDATA[<examples>
  <example name="technical_seo_audit">
    <description>Complete technical SEO audit workflow for a website</description>
    <context>When user needs comprehensive SEO analysis and optimization plan</context>
    <workflow_steps>
      <step number="1">
        <title>Initial Research and Analysis</title>
        <actions>
          <action>Research current SEO landscape and competitor strategies</action>
          <tools_used>
            <tool>web_search - "SEO audit tools 2024 competitor analysis"</tool>
            <tool>codebase_search - "meta tags structured data sitemap"</tool>
          </tools_used>
        </actions>
        <outcomes>
          <result>Identified top 3 competitors and their SEO strategies</result>
          <result>Found existing meta tag implementation gaps</result>
          <result>Discovered missing structured data opportunities</result>
        </outcomes>
      </step>
      
      <step number="2">
        <title>Technical Implementation Review</title>
        <actions>
          <action>Analyze current technical SEO setup</action>
          <tools_used>
            <tool>read_file - index.html, robots.txt, sitemap.xml</tool>
            <tool>browser - Test Core Web Vitals and structured data</tool>
          </tools_used>
        </actions>
        <outcomes>
          <result>Core Web Vitals: LCP 3.2s, FID 180ms, CLS 0.15</result>
          <result>Structured data validation: 2 critical errors found</result>
          <result>Mobile usability issues identified on key pages</result>
        </outcomes>
      </step>
      
      <step number="3">
        <title>Optimization Implementation</title>
        <actions>
          <action>Implement technical SEO improvements</action>
          <tools_used>
            <tool>apply_diff - Update meta tags and add structured data</tool>
            <tool>write_to_file - Create enhanced robots.txt and sitemap</tool>
            <tool>execute_command - "npm run optimize-images"</tool>
          </tools_used>
        </actions>
        <outcomes>
          <result>Meta tags optimized with target keywords and compelling descriptions</result>
          <result>JSON-LD structured data implemented for articles and products</result>
          <result>XML sitemap generated with 150+ URLs</result>
          <result>Image optimization reduced page load time by 40%</result>
        </outcomes>
      </step>
      
      <step number="4">
        <title>Validation and Monitoring</title>
        <actions>
          <action>Test implementations and set up monitoring</action>
          <tools_used>
            <tool>browser - Validate structured data with Google Rich Results Test</tool>
            <tool>web_search - "Google Search Console setup tracking"</tool>
          </tools_used>
        </actions>
        <outcomes>
          <result>Structured data validation passed for all schema types</result>
          <result>Core Web Vitals improved to: LCP 1.8s, FID 85ms, CLS 0.05</result>
          <result>Analytics tracking configured for SEO KPIs</result>
        </outcomes>
      </step>
    </workflow_steps>
    <deliverables>
      <deliverable>Comprehensive SEO audit report with prioritized recommendations</deliverable>
      <deliverable>Implemented technical SEO improvements (meta tags, structured data, sitemap)</deliverable>
      <deliverable>Performance optimization results and monitoring setup</deliverable>
      <deliverable>Documentation of all changes and best practices for maintenance</deliverable>
    </deliverables>
  </example>

  <example name="content_optimization_strategy">
    <description>Content SEO optimization for blog post targeting specific keywords</description>
    <context>When user wants to optimize existing content for better search rankings</context>
    <workflow_steps>
      <step number="1">
        <title>Keyword Research and Content Analysis</title>
        <actions>
          <action>Research target keywords and analyze current content</action>
          <tools_used>
            <tool>web_search - "keyword research tools long-tail variations 2024"</tool>
            <tool>read_file - existing blog posts and content structure</tool>
          </tools_used>
        </actions>
        <outcomes>
          <result>Identified primary keyword: "SEO best practices guide"</result>
          <result>Found 15 long-tail variations with good search volume</result>
          <result>Current content missing semantic keyword variations</result>
        </outcomes>
      </step>
      
      <step number="2">
        <title>Content Enhancement and Optimization</title>
        <actions>
          <action>Optimize content structure and incorporate keywords naturally</action>
          <tools_used>
            <tool>apply_diff - Update headings, add keyword variations</tool>
            <tool>write_to_file - Create new optimized content sections</tool>
          </tools_used>
        </actions>
        <outcomes>
          <result>Content restructured with H1-H3 hierarchy for better readability</result>
          <result>Primary keyword density optimized to 2.1%</result>
          <result>Added 8 semantic keyword variations throughout content</result>
          <result>Internal linking strategy implemented with 12 relevant links</result>
        </outcomes>
      </step>
      
      <step number="3">
        <title>Meta Tags and Structured Data Enhancement</title>
        <actions>
          <action>Update meta tags and add comprehensive structured data</action>
          <tools_used>
            <tool>apply_diff - Update title, description, and meta tags</tool>
            <tool>write_to_file - Add JSON-LD structured data</tool>
          </tools_used>
        </actions>
        <outcomes>
          <result>Title optimized: "Complete SEO Best Practices Guide 2024 | Expert Tips"</result>
          <result>Meta description under 160 characters with primary keyword</result>
          <result>Article schema implemented with author, publisher, and date information</result>
        </outcomes>
      </step>
      
      <step number="4">
        <title>Performance Validation</title>
        <actions>
          <action>Test content performance and SEO implementation</action>
          <tools_used>
            <tool>browser - Test page load speed and user experience</tool>
            <tool>execute_command - "npx lighthouse --performance"</tool>
          </tools_used>
        </actions>
        <outcomes>
          <result>Page load time improved from 3.2s to 1.8s</result>
          <result>Lighthouse SEO score increased from 72 to 89</result>
          <result>Mobile usability score improved to 95/100</result>
        </outcomes>
      </step>
    </workflow_steps>
    <deliverables>
      <deliverable>Keyword-optimized content with natural keyword integration</deliverable>
      <deliverable>Enhanced meta tags and structured data implementation</deliverable>
      <deliverable>Improved page performance and user experience metrics</deliverable>
      <deliverable>Content optimization report with before/after comparisons</deliverable>
    </deliverables>
  </example>

  <example name="local_seo_implementation">
