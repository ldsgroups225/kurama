            <tool>web_search - "local SEO multi-location business strategy 2024"</tool>
            <tool>codebase_search - "location pages contact information schema"</tool>
          </tools_used>
        </actions>
        <outcomes>
          <result>Identified 5 key local search ranking factors</result>
          <result>Analyzed top 3 local competitors' citation strategies</result>
          <result>Found opportunity for location-specific landing pages</result>
