{
  "name": "@kurama/data-ops",
  "version": "1.0.0",
  "description": "Shared utilities for Kurama - auth, database, schemas, and queries",
  "exports": {
    "./auth/*": {
      "default": "./dist/auth/*.js",
      "types": "./dist/auth/*.d.ts"
    },
    "./database/*": {
      "default": "./dist/database/*.js",
      "types": "./dist/database/*.d.ts"
    },
    "./drizzle/*": {
      "default": "./dist/drizzle/*.js",
      "types": "./dist/drizzle/*.d.ts"
    },
    "./zod-schema/*": {
      "default": "./dist/zod-schema/*.js",
      "types": "./dist/zod-schema/*.d.ts"
    },
    "./queries/*": {
      "default": "./dist/queries/*.js",
      "types": "./dist/queries/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir ./dist && tsc-alias",
    "better-auth:generate": "mkdir -p src/drizzle && npx @better-auth/cli@latest generate --config ./config/auth.ts --output ./src/drizzle/auth-schema.ts",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "drizzle:pull": "drizzle-kit pull --config drizzle.config.ts",
    "seed": "tsx src/seeds/seed-db.ts",
    "seed:lessons": "tsx src/seeds/seed-all-comprehensive.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@neondatabase/serverless": "catalog:backend",
    "@planetscale/database": "catalog:backend",
    "@polar-sh/better-auth": "catalog:integrations",
    "@polar-sh/sdk": "catalog:integrations",
    "better-auth": "catalog:frontend",
    "better-sqlite3": "catalog:backend",
    "drizzle-orm": "catalog:backend",
    "zod": "catalog:shared"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:backend",
    "@types/better-sqlite3": "catalog:dev",
    "dotenv": "catalog:dev",
    "drizzle-kit": "catalog:backend",
    "mysql2": "catalog:backend",
    "postgres": "catalog:backend",
    "tsc-alias": "catalog:build",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
