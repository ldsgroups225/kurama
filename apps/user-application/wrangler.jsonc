{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kurama",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./src/server.ts",
  "vars": {
    "DATABASE_HOST": "ep-late-lake-agik2cni-pooler.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require",
    "GOOGLE_CLIENT_ID": "18833168509-f0smil5qed52l0gpcj8nsmthmrervseb.apps.googleusercontent.com"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": false,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
