{
  "name": "kurama-frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:production": "vite build && pnpm run perf:check-bundles",
    "build:analyze": "vite build && open dist/stats.html",
    "analyze": "vite build --mode production && open dist/stats.html",
    "deploy": "pnpm run build:production && wrangler deploy",
    "serve": "vite preview",
    "cf-typegen": "wrangler types --env-interface Env",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "perf:check": "tsx scripts/check-performance.ts",
    "perf:check-bundles": "tsx scripts/check-bundle-size.ts",
    "perf:validate": "pnpm run build && pnpm run perf:check-bundles",
    "validate:optimizations": "tsx scripts/validate-optimizations.ts",
    "validate:all": "pnpm run typecheck && pnpm run build && pnpm run validate:optimizations",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kurama/data-ops": "workspace:^",
    "@polar-sh/sdk": "catalog:integrations",
    "@polar-sh/tanstack-start": "catalog:integrations",
    "@radix-ui/react-avatar": "catalog:ui",
    "@radix-ui/react-collapsible": "catalog:ui",
    "@radix-ui/react-dialog": "catalog:ui",
    "@radix-ui/react-dropdown-menu": "catalog:ui",
    "@radix-ui/react-label": "catalog:ui",
    "@radix-ui/react-scroll-area": "catalog:ui",
    "@radix-ui/react-select": "catalog:ui",
    "@radix-ui/react-slider": "catalog:ui",
    "@radix-ui/react-slot": "catalog:ui",
    "@radix-ui/react-switch": "catalog:ui",
    "@radix-ui/react-toggle": "catalog:ui",
    "@radix-ui/react-toggle-group": "catalog:ui",
    "@radix-ui/react-tooltip": "catalog:ui",
    "@tailwindcss/typography": "catalog:ui",
    "@tailwindcss/vite": "catalog:ui",
    "@tanstack/query-persist-client-core": "catalog:frontend",
    "@tanstack/query-sync-storage-persister": "catalog:frontend",
    "@tanstack/react-query": "catalog:frontend",
    "@tanstack/react-query-devtools": "catalog:frontend",
    "@tanstack/react-query-persist-client": "catalog:frontend",
    "@tanstack/react-router": "catalog:frontend",
    "@tanstack/react-router-devtools": "catalog:frontend",
    "@tanstack/react-router-ssr-query": "catalog:frontend",
    "@tanstack/react-start": "catalog:frontend",
    "better-auth": "catalog:frontend",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "dexie": "catalog:shared",
    "dexie-react-hooks": "catalog:shared",
    "highlight.js": "catalog:shared",
    "jotai": "catalog:frontend",
    "katex": "catalog:shared",
    "lucide-react": "catalog:ui",
    "motion": "catalog:ui",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "react-icons": "catalog:ui",
    "react-markdown": "catalog:shared",
    "rehype-highlight": "catalog:shared",
    "rehype-katex": "catalog:shared",
    "remark-breaks": "catalog:shared",
    "remark-gfm": "catalog:shared",
    "remark-math": "catalog:shared",
    "tailwind-merge": "catalog:ui",
    "tailwindcss": "catalog:ui",
    "tw-animate-css": "catalog:ui",
    "vite-tsconfig-paths": "catalog:build",
    "zod": "catalog:shared"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:build",
    "@kurama/eslint-config": "workspace:^",
    "@testing-library/dom": "catalog:test",
    "@testing-library/jest-dom": "catalog:test",
    "@testing-library/react": "catalog:test",
    "@types/katex": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@types/remark-prism": "catalog:dev",
    "@vitejs/plugin-react": "catalog:build",
    "@vitest/eslint-plugin": "catalog:test",
    "eslint": "catalog:lint",
    "eslint-plugin-better-tailwindcss": "catalog:lint",
    "jsdom": "catalog:test",
    "rollup-plugin-visualizer": "catalog:build",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:build",
    "vite-plugin-pwa": "catalog:build",
    "vitest": "catalog:test",
    "web-vitals": "catalog:test",
    "workbox-build": "catalog:pwa",
    "workbox-core": "catalog:pwa",
    "workbox-expiration": "catalog:pwa",
    "workbox-precaching": "catalog:pwa",
    "workbox-routing": "catalog:pwa",
    "workbox-strategies": "catalog:pwa",
    "workbox-window": "catalog:pwa",
    "wrangler": "catalog:build"
  }
}
