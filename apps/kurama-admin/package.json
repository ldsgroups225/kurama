    "better-auth": "catalog:frontend",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "cmdk": "catalog:ui",
    "date-fns": "catalog:shared",
    "embla-carousel-react": "catalog:ui",
    "framer-motion": "catalog:ui",
    "input-otp": "catalog:ui",
    "katex": "catalog:shared",
    "lucide-react": "catalog:ui",
    "next-themes": "catalog:ui",
    "react": "catalog:frontend",
    "react-day-picker": "catalog:ui",
    "react-dom": "catalog:frontend",
