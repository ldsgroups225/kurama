{
  "name": "kurama-admin",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build --mode production",
    "deploy": "pnpm run build && wrangler deploy",
    "serve": "cp .env.production .dev.vars && vite preview --mode production --port 9800",
    "serve:dev": "cp .env.development .dev.vars && vite preview --port 9800",
    "cf-typegen": "wrangler types --env-interface Env",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "catalog:ui",
    "@dnd-kit/sortable": "catalog:ui",
    "@dnd-kit/utilities": "catalog:ui",
